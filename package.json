{
  "name": "tytab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Extensao Chrome (MV3) para organizar abas em grupos",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run icons && tsc -b && vite build && npm run verify",
    "verify": "node scripts/verify-dist.mjs",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "icons": "node scripts/generate-icons.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
